    "/api/movies/{movieId}/screenings": {
      "get": {
        "operationId": "MovieScreeningsController_listScreeningsByMovieAndDate",
        "parameters": [
          {
            "name": "movieId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "YYYY-MM-DD calendar date",
            "schema": {
              "format": "date",
              "example": "2026-09-20",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListScreeningsByMovieAndDateResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "date가 YYYY-MM-DD 형식의 실제 calendar date가 아닙니다."
          }
        },
        "summary": "영화 날짜별 상영 목록 조회",
        "tags": [
          "screenings"
        ]
      }
