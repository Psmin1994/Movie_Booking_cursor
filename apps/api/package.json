{
  "name": "@movie-booking/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "generate:openapi": "nest build && tsx scripts/generate-openapi.ts",
    "db:migrate:dev": "node --env-file=.env ./scripts/run-prisma.mjs migrate:dev",
    "db:migrate:deploy": "node --env-file=.env ./scripts/run-prisma.mjs migrate:deploy",
    "db:seed": "node --env-file=.env --import tsx scripts/seed-users.ts",
    "db:seed:movies": "node --env-file=.env --import tsx scripts/seed-movies.ts",
    "db:seed:screenings": "node --env-file=.env --import tsx scripts/seed-screenings.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:int": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-int.json",
    "test:concurrency": "node --env-file=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-concurrency.json",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:all": "pnpm test && pnpm test:int && pnpm test:concurrency && pnpm test:e2e"
  },
  "dependencies": {
    "@movie-booking/database-prisma": "workspace:*",
    "@movie-booking/shared": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "joi": "^18.2.8",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@movie-booking/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}